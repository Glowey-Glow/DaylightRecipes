package-as: DaylightRecipes

# Kept in the repo, left out of the zip players download. LICENSE.md and AGENTS.md ship with it.
ignore:
  - README.md
  - CHANGELOG.md
  - CURSEFORGE.md
  - .github
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - .luacheckrc
  - Tools

manual-changelog:
